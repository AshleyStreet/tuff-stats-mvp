# Copy to deploy/lightsail/.env on the instance (never commit .env).

NODE_ENV=production
PORT=4000
TRUST_PROXY=1

LEAGUE_SLUG=tuff
# Optional. Overrides TUFF's configured source URL (server/src/leagues/tuff.ts).
TUFF_STATS_URL=https://www.playtuff.ca/list/2026-tuff-stats/

# Required for /admin and tenant CRUD (POST/PUT /api/admin/tenants, /api/admin/probe)
ADMIN_TOKEN=
# Optional. Per-tenant secret for POST /api/admin/refresh and ?refresh=1 on that
# tenant only — without it, ADMIN_TOKEN above still works as a fallback.
# ADMIN_TOKEN_TUFF=

# Comma-separated public hostnames for Caddy HTTPS (spaces after commas required).
# SITE_HOSTS=afterwhistle.ca, www.afterwhistle.ca, tuff.afterwhistle.ca

# Single-host fallback used if SITE_HOSTS is unset.
# DOMAIN=afterwhistle.ca

# Web analytics (Docker build args — must pass --env-file on build; see README).
VITE_GA_MEASUREMENT_ID=G-N0V6N4PWVL
