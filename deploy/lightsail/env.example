# Copy to deploy/lightsail/.env on the instance (never commit .env).

NODE_ENV=production
PORT=4000
TRUST_PROXY=1

LEAGUE_SLUG=tuff
TUFF_STATS_URL=https://www.playtuff.ca/list/2026-tuff-stats/
TUFF_LIST_SLUG=2026-tuff-stats

# Required for /admin and POST /api/admin/*
ADMIN_TOKEN=

# Comma-separated public hostnames for Caddy HTTPS (preferred).
# Apex + www = marketing site; tuff. = TUFF league app.
# SITE_HOSTS=afterwhistle.ca, www.afterwhistle.ca, tuff.afterwhistle.ca

# Single-host fallback used if SITE_HOSTS is unset.
# DOMAIN=afterwhistle.ca
