# Copy to deploy/lightsail/.env on the instance (never commit .env).

NODE_ENV=production
PORT=4000
TRUST_PROXY=1

LEAGUE_SLUG=tuff
TUFF_STATS_URL=https://www.playtuff.ca/list/2026-tuff-stats/
TUFF_LIST_SLUG=2026-tuff-stats

# Required for /admin and POST /api/admin/*
ADMIN_TOKEN=

# Public hostname on the existing playtuff.ca domain.
# Uncomment after the GoDaddy A record for "stats" points at this instance.
# DOMAIN=stats.playtuff.ca
