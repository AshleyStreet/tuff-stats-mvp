PORT=4000
NODE_ENV=production
LEAGUE_SLUG=tuff
# Host demo.localhost / anotherleague.localhost serves the Harbor fixture tenant.
# Optional. Overrides TUFF's configured source URL (server/src/leagues/tuff.ts).
TUFF_STATS_URL=https://www.playtuff.ca/list/2026-tuff-stats/
# Optional. Overrides Bush League SportsPress origin (default https://www.bushleaguetoronto.ca).
BUSH_ORIGIN=
# Optional. Overrides Passion Soccer SportsPress origin (default https://passion-soccer.com).
PASSION_ORIGIN=
# Optional. Enables /admin and tenant CRUD (POST/PUT /api/admin/tenants, /api/admin/probe).
ADMIN_TOKEN=
# Optional. Per-tenant secret for POST /api/admin/refresh and ?refresh=1 on that
# tenant only — without it, ADMIN_TOKEN above still works as a fallback.
# ADMIN_TOKEN_TUFF=
# Optional. Defaults to server/.cache/{league}/ (bind-mount this on Lightsail).
CACHE_DIR=
# Optional. JSON tenant overlays. Defaults to server/.tenants/.
TENANTS_DIR=
