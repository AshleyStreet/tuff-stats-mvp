# Optional web analytics (baked in at build time).
# Set one or both. Disabled in dev unless VITE_ANALYTICS_DEBUG=true.

# Google Analytics 4 (Afterwhistle property)
VITE_GA_MEASUREMENT_ID=G-N0V6N4PWVL

# Plausible domain (e.g. afterwhistle.ca)
# VITE_PLAUSIBLE_DOMAIN=

# Optional Plausible script URL (self-hosted or custom CDN)
# VITE_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# Track page views in local dev when IDs are set
# VITE_ANALYTICS_DEBUG=true

# Stripe Payment Links for the pricing section (Dashboard → Payment links).
# Each link must contain a single price only — one plan per link.
# Falls back to the "book a demo" mailto CTA when unset.
# VITE_STRIPE_LEAGUE_LINK=https://buy.stripe.com/xxxxx
# VITE_STRIPE_CLUB_LINK=https://buy.stripe.com/xxxxx
